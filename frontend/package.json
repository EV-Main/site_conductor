{
  "name": "site_conductor",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "predev": "npm install --no-audit --no-fund",
    "dev": "next dev",
    "prebuild": "npm install --no-audit --no-fund && npm run i18n:check && tsx scripts/build-og.tsx",
    "build": "stylelint \"application/styles/**/*.css\" && tsx scripts/css-conflict-check.mts && next build",
    "start": "next start",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "gen:api": "openapi-ts",
    "lint:css": "stylelint \"application/styles/**/*.css\"",
    "css:check": "tsx scripts/css-conflict-check.mts",
    "format": "prettier --write .",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "i18n:extract": "evinvest-i18n-extract --exclude public,assets,messages,tests,test-results,playwright-report,generated",
    "i18n:check": "evinvest-i18n-check --exclude public,assets,messages,tests,test-results,playwright-report,generated",
    "redirects:check": "tsx scripts/redirect-check.mts"
  },
  "dependencies": {
    "@evinvest/analytics": "^0.4.0",
    "@evinvest/error-monitoring": "^0.1.0",
    "@evinvest/experiments": "^0.4.0",
    "@evinvest/i18n": "^0.9.0",
    "@evinvest/uikit": "^0.26.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.56.0",
    "@sentry/node": "^10.56.0",
    "@sentry/react": "^10.56.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "motion": "^12.23.22",
    "nanoid": "^5.1.5",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.381.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "streamdown": "^1.4.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.15",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.4.47",
    "prettier": "^3.6.2",
    "stylelint": "^17.12.0",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.6.3"
  }
}
