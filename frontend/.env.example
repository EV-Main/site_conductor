# Public (client-exposed) env vars — all must be prefixed NEXT_PUBLIC_.
# Topology (NEXT_PUBLIC_API_URL, CABINET_ZONE_URL, REA_ZONE_URL, AUTH_WEB_URL)
# DEFAULTS from flake.nix (the `ports` attrset); anything set here or in the
# environment wins.

# Canonical production origin (https, NO trailing slash, pick www-or-not once).
# Drives metadataBase, canonical URLs, robots host, sitemap URLs, the OG image
# base, and every JSON-LD @id. Without it the build falls back to the obvious
# placeholder https://evinvest.example — set this before going live.
NEXT_PUBLIC_SITE_URL=https://evinvest.example

# Server-only override for Server Component fetches (e.g. an internal/cluster
# address). NOT exposed to the browser. Required in production (config.ts
# prodRequired); unset in dev ⇒ falls back to NEXT_PUBLIC_API_URL (which the
# flake exports from SITE_CONDUCTOR_BACKEND_PORT).
API_URL_INTERNAL=

# Cabinet zone (multi-zone mount — see PATTERNS.md §9). CABINET_ZONE_URL
# (server-only, the cabinet deployment's origin) is exported by the flake in dev
# from CABINET_FRONTEND_PORT; set it here only to point at a non-local cabinet.
# BUILD-TIME: the asset/API rewrites it feeds are captured into the routes
# manifest — flipping the zone needs a rebuild.
CABINET_ZONE_URL=

# REA zone (same mount as the cabinet: /rea/assets, /rea/api rewrites + the
# HTML proxy). Server-only, required in production (config.ts prodRequired);
# the flake exports it in dev from REA_PORT.
REA_ZONE_URL=

# The concierge plane's auth web surface: /api/auth/*, /api/callback/auth/* and
# /api/kyc/* on this origin rewrite there. Server-only, required in production
# (config.ts prodRequired); the flake exports it in dev from CONCIERGE_WEB_PORT.
# Unset ⇒ auth and KYC disabled.
AUTH_WEB_URL=

# REA backend origin advertised to the portfolio embed via <meta name="rea-url">.
# Required in production. Production: https://rea.evinvest.ltd
# BUILD-TIME: NEXT_PUBLIC_* is inlined at `next build`.
NEXT_PUBLIC_REA_URL=

# Host of the public landing. Every retired landing path on this origin
# (/team, /publications/*, /cabinet/*, …) 301s there with its path kept.
# Server-only; defaults to https://invest.evinvest.ltd when unset.
# BUILD-TIME: redirects() is captured into the routes manifest.
INVEST_ORIGIN=

# Umami analytics (loaded in application/layout/site-document.tsx when both are set)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# PostHog product analytics (cta_clicked, *_exposed, $pageview). The project
# key is a browser value — it ships in the bundle — so prod bakes it as a
# literal in flake.nix (`posthogKey`), not through sops. Same project as the
# cabinet so the funnel is continuous across zones. Empty ⇒ no-op sink.
# BUILD-TIME: NEXT_PUBLIC_* is inlined at `next build`.
NEXT_PUBLIC_POSTHOG_KEY=phc_sBwWEgdgockVmfyucBRkTTo6iZ4Y2eApSGorD22WLzj3
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (public DSN is safe to share).
# SENTRY_AUTH_TOKEN is only needed in CI for source map uploads — never in .env.local.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=development
SENTRY_DSN=
# Server/edge environment tag (Sentry.init in instrumentation.ts).
APP_ENV=development
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
